MONGO_URL=mongodb://localhost:27017
DB_NAME=dishfinder
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ANONYMOUS_ACCESS_TOKEN_EXPIRE_DAYS=7
ANONYMOUS_REFRESH_TOKEN_EXPIRE_DAYS=30
GOOGLE_MAPS_API_KEY=
CORS_ORIGINS=

# Public backend origin used in emailed /api/auth/verify-email links.
FRONTEND_URL=https://api.example.com
APP_NAME=DishFinder
# Create a sending-access API key after verifying the EMAIL_FROM domain in Resend.
RESEND_API_KEY=
EMAIL_FROM="DishFinder <sender@example.com>"
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
